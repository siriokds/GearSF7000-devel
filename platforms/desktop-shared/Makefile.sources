ENABLE_RECORDER ?= 1
ifeq ($(ENABLE_RECORDER),1)
    SOURCES_CXX += \
        $(SRC_DIR)/VgmRecorder.cpp \
        $(SRC_DIR)/WavRecorder.cpp
endif

# Debugger and MCP are a product profile, not a Release/Debug compiler
# distinction. The reduced GearSC3000 product links a tiny compatibility shim
# for the desktop shell and does not compile the debugger implementation or
# disassembler at all.
ENABLE_DEBUG_TOOLS ?= 1
ifeq ($(ENABLE_DEBUG_TOOLS),1)
    SOURCES_CXX += \
        $(DESKTOP_SRC_DIR)/gui_debug.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_events.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_nametable.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_pattern_table.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_sprites.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_video_registers.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_memory.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_mem_import.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_audio.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_basic_typer.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_disassembler_export.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_rom_inspector.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_rewind.cpp \
        $(SRC_DIR)/Z80Disassembler.cpp \
        $(SRC_DIR)/RomMap.cpp \
        $(SRC_DIR)/SourceListing.cpp \
        $(SRC_DIR)/JumpTables.cpp \
        $(SRC_DIR)/DeepSearch.cpp \
        $(DESKTOP_SRC_DIR)/rom_map_project.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_rom_map.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_disassembler_view.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_deep_search.cpp \
        $(DESKTOP_SRC_DIR)/gui_debug_palettes.cpp
else
    SOURCES_CXX += $(DESKTOP_SRC_DIR)/gui_debug_stub.cpp
endif

ENABLE_MCP ?= 0
ifeq ($(ENABLE_MCP),1)
    SOURCES_CXX += \
        $(DESKTOP_SRC_DIR)/mcp/mcp_debug_adapter.cpp \
        $(DESKTOP_SRC_DIR)/mcp/mcp_tool_registry.cpp \
        $(DESKTOP_SRC_DIR)/mcp/mcp_tool_definitions_core.cpp \
        $(DESKTOP_SRC_DIR)/mcp/mcp_tool_definitions_debug.cpp \
        $(DESKTOP_SRC_DIR)/mcp/mcp_tool_definitions_input.cpp \
        $(DESKTOP_SRC_DIR)/mcp/mcp_server.cpp
endif

# Pico9918 is an optional video-device module. The full desktop product builds
# it by default; reduced frontends opt out until they expose the device.
ENABLE_PICO9918 ?= 1
USE_PICOSMSVDP_CORE ?= 1
ifeq ($(ENABLE_PICO9918),1)
    SOURCES_C += $(SRC_DIR)/Pico9918LegacyCoreBridge.c
    SOURCES_CXX += $(SRC_DIR)/Pico9918LegacyCore.cpp $(SRC_DIR)/Pico9918.cpp
ifeq ($(USE_PICOSMSVDP_CORE),1)
    SOURCES_CXX += $(SRC_DIR)/PicoSMSVdpCoreAdapter.cpp
endif
endif

# The AY expansion is optional. Defined here rather than in Makefile.common
# because that file is included after this one, and the source list has to know.
# Makefile.common turns the same variable into -DGEARSF7000_ENABLE_AY. Keeping
# the source out of the build when disabled avoids the situation AY8910.cpp was
# in for a long time: compiled into every binary while entirely disconnected.
ENABLE_AY ?= 1
ifeq ($(ENABLE_AY),1)
    SOURCES_CXX += $(SRC_DIR)/audio/Ay_Apu.cpp
endif

# YM2413 FM Sound Unit. emu2413 is the MIT-licensed synthesis core vendored
# from the same libgme checkout as the existing audio components.
ENABLE_YM2413 ?= 1
ifeq ($(ENABLE_YM2413),1)
    SOURCES_C += $(SRC_DIR)/audio/emu2413.c
    SOURCES_CXX += $(SRC_DIR)/audio/Ym2413.cpp
endif

# The SF-7000 floppy drive (FDC + disk image formats + its own disc explorer
# debug window) is optional, same reasoning as ENABLE_AY above. Off by default
# only for a future cartridge-only build (e.g. libretro); every one of this
# project's own build targets keeps it at the default of 1.
ENABLE_SF7000 ?= 1
ifeq ($(ENABLE_SF7000),1)
    SOURCES_CXX += \
        $(SRC_DIR)/NEC765.cpp \
        $(SRC_DIR)/SF7000.cpp \
        $(SRC_DIR)/SF7000Memory.cpp \
        $(SRC_DIR)/SF7000ParallelPrinterPort.cpp \
        $(SRC_DIR)/Disk.cpp \
        $(SRC_DIR)/DiskLayout.cpp \
        $(SRC_DIR)/EDSKLoader.cpp \
        $(SRC_DIR)/HFELoader.cpp \
        $(SRC_DIR)/DS7Format.cpp \
        $(SRC_DIR)/sf7fs/SF7Disc.cpp \
        $(SRC_DIR)/WavChannel.cpp \
        $(SRC_DIR)/WavPlayer.cpp \
        $(SRC_DIR)/WavSample.cpp \
        $(SRC_DIR)/WavSampleManager.cpp
    ifeq ($(ENABLE_DEBUG_TOOLS),1)
        SOURCES_CXX += $(DESKTOP_SRC_DIR)/gui_debug_disc_explorer.cpp
    endif
endif

# The SR-1000 cassette recorder, same pattern.
ENABLE_SR1000 ?= 1
ifeq ($(ENABLE_SR1000),1)
    SOURCES_CXX += \
        $(SRC_DIR)/SR1000.cpp \
        $(SRC_DIR)/TapeRecorder.cpp \
        $(SRC_DIR)/MSXTape.cpp \
        $(SRC_DIR)/SR1000_Speaker.cpp \
        $(SRC_DIR)/SegaBasicBitTape.cpp \
        $(SRC_DIR)/SegaBasicWavTape.cpp \
        $(SRC_DIR)/Tape.cpp \
        $(SRC_DIR)/TapeMotor.cpp \
        $(SRC_DIR)/SPITapePlayer.cpp
endif
