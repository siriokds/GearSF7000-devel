00:1C66 INIT_SPR_ORDER_
; via vector $1F97
00:1C76 WR_SPR_NM_TBLQ
; via vector $1FC4
00:1C82 WR_SPR_NM_TBL_
; via vector $1FA6
00:1CBC REG_WRITEQ
; via vector $1FD9
00:1CCA REG_WRITE
; via vector $1FA9
00:1CED WRITE_VRAMQ
; via vector $1FDF
00:1D01 VRAM_WRITE
; via vector $1FAC
00:1D2A READ_VRAMQ
; via vector $1FE2
00:1D3E VRAM_READ
; (in READ_VRAM, equal I/O port# BF)
00:1D43 CTRL_PORT_PTR
; (in READ_VRAM, equal I/O port# BE)
00:1D47 DATA_PORT_PTR
; via vector $1FDC
00:1D57 REG_READ
; via vector $1F6A
00:1D5A RFLCT_VERT
