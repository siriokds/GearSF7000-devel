; ColecoVision OS 7 BIOS symbols ($0000-$1FFF).
; Sources: the ColecoVision Coding Guide (OS 7 jump table, OS7SYM appendix) and
; the coleco29.asm commented disassembly. Vectors are V_<name>; each vector's
; target carries the routine name. Loaded with the ColecoVision board, next
; to the cartridge symbols. No ROM bytes here.
[labels]
; via vector $1FFD
00:003B RAND_GEN_
; 60 = NTSC, 50 = PAL
00:0069 AMERICA
; Pointer to uppercase ASCII pattern
00:006A ASCII_TABLE
; Pointer to numbers 0-9 pattern
00:006C NUMBER_TABLE
; Frequency sweep
00:00FC FREQ_SWEEP
; Attenuation sweep
00:012F ATN_SWEEP
; Decrement low nibble (in UTILITY)
00:0190 DECLSN
; Decrement high nibble (in UTILITY)
00:019B DECMSN
; Copy high nibble to low nibble (in UTILITY)
00:01A6 MSNTOLSN
; Add signed 8bit value A to 16bit [HL]
00:01B1 ADD816
; Called by a special sound effect function when done
00:01D5 LEAVE_EFFECT
; via vector $1FB2
00:0203 INIT_SOUNDQ
; via vector $1FEE
00:0213 INIT_SOUND
; via vector $1FD6
00:023B ALL_OFF
; via vector $1FB5
00:0251 JUKE_BOXQ
; via vector $1FF1
00:025E JUKE_BOX
; via vector $1FF4
00:027F SND_MANAGER
; (in PROCESS_DATA_AREA to get next note)
00:02EE EFXOVER
; via vector $1F61
00:0300 PLAY_SONGS_
; via vector $1F64
00:0488 ACTIVATEQ
; via vector $1FF7
00:04A3 ACTIVATE_
; via vector $1FAF
00:0655 INIT_QUEUEQ
; via vector $1FE5
00:0664 INIT_QUEUE
; via vector $1FE8
00:0679 WRITER_
; via vector $1F67
00:06C7 PUTOBJQ
; via vector $1FFA
00:06D8 PUTOBJ_
; Pixel to pattern plane position
00:07E8 PX_TO_PTRN_POS
; Copy a block of names to VRAM
00:080B PUT_FRAME
; Copy a block of names from VRAM to RAM
00:0898 GET_BKGRND
; Returns DE := offset for the coordinates (E,D)
00:08C0 CALC_OFFSET
; via vector $1FD3
00:0F37 TIME_MGR_
; via vector $1F9A
00:0F9A INIT_TIMERQ
; via vector $1FC7
00:0FAA INIT_TIMER_
; via vector $1F9D
00:0FB8 FREE_SIGNALQ
; via vector $1FCA
00:0FC4 FREE_SIGNAL_
; via vector $1FA0
00:1044 REQUEST_SIGNALQ
; via vector $1FCD
00:1053 REQUEST_SIGNAL_
; via vector $1FA3
00:10BF TEST_SIGNALQ
; via vector $1FD0
00:10CB TEST_SIGNAL_
; via vector $1F76
00:114A CONT_SCAN
; via vector $1F88
00:116A UPDATE_SPINNER_
; via vector $1F79
00:118B DECODER_
; via vector $1FEB
00:11C1 POLLER_
; via vector $1F82
00:18D4 FILL_VRAM_
; via vector $1F85
00:18E9 MODE_1_
; via vector $1F7F
00:1927 LOAD_ASCII_
; via vector $1F7C
00:1979 GAME_OPT_
; via vector $1F8B
00:1B0E INIT_TABLEQ
; via vector $1FB8
00:1B1D INIT_TABLE_
; via vector $1F8E
00:1B8C GET_VRAMQ
; via vector $1FBB
00:1BA3 GET_VRAM_
; via vector $1F91
00:1C10 PUT_VRAMQ
; via vector $1FBE
00:1C27 PUT_VRAM_
; via vector $1F94
00:1C5A INIT_SPR_ORDERQ
